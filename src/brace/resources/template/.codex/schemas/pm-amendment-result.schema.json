{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "taskId",
        "title",
        "description",
        "requirementIds",
        "planSections",
        "dependencies",
        "allowedPaths",
        "exclusiveResources",
        "acceptanceCriteria",
        "checks"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^TASK-[0-9]{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "planSections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
          },
          "uniqueItems": true
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exclusiveResources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "status",
    "summary",
    "decisionIdentity",
    "selectedOptionId",
    "commitSha",
    "changedFiles",
    "newTasks",
    "supersededTaskIds",
    "resumeStage",
    "blocker"
  ],
  "properties": {
    "status": {
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "commitSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "newTasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "supersededTaskIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{4}$"
      },
      "uniqueItems": true
    },
    "resumeStage": {
      "enum": [
        "build",
        "audit"
      ]
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "decisionIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selectedOptionId": {
      "type": "string",
      "pattern": "^OPTION-[0-9]{4}$"
    }
  },
  "additionalProperties": false
}
