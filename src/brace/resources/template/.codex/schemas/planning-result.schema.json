{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "questions", "normalizedRequirementsMarkdown", "planMarkdown", "tasks", "summary"],
  "properties": {
    "status": { "enum": ["questions", "complete"] },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionId", "question", "reason"],
        "properties": {
          "questionId": { "type": "string", "pattern": "^QUESTION-[0-9]{4}$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "normalizedRequirementsMarkdown": { "type": ["string", "null"] },
    "planMarkdown": { "type": ["string", "null"] },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["taskId", "title", "description", "requirementIds", "planSections", "dependencies", "allowedPaths", "exclusiveResources", "acceptanceCriteria", "checks"],
        "properties": {
          "taskId": { "type": "string", "pattern": "^TASK-[0-9]{4}$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" }, "uniqueItems": true },
          "planSections": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" }, "uniqueItems": true },
          "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "exclusiveResources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["requirementsCount", "taskCount", "parallelizableTaskCount", "assumptions", "deferredScope", "deferredRequirementIds"],
      "properties": {
        "requirementsCount": { "type": "integer", "minimum": 0 },
        "taskCount": { "type": "integer", "minimum": 0 },
        "parallelizableTaskCount": { "type": "integer", "minimum": 0 },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "deferredScope": { "type": "array", "items": { "type": "string" } },
        "deferredRequirementIds": { "type": "array", "items": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
