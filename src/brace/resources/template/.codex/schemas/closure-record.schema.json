{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "cycle",
    "candidateSha",
    "completedAt",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "enum": ["audit", "validation"] },
    "cycle": { "type": "integer", "minimum": 1 },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "completedAt": { "type": "string", "format": "date-time" },
    "result": {
      "oneOf": [
        { "$ref": "audit-result.schema.json" },
        { "$ref": "verifier-result.schema.json" }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "audit" } } },
      "then": { "properties": { "result": { "$ref": "audit-result.schema.json" } } },
      "else": { "properties": { "result": { "$ref": "verifier-result.schema.json" } } }
    }
  ]
}
