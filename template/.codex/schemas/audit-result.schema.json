{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "bugs", "checks", "missingEvidence"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bugId", "title", "severity", "category", "requirementIds", "description", "evidence", "actualBehavior", "requiredBehavior", "impact", "requiredCorrection", "acceptanceTest", "dependencies", "allowedPaths", "exclusiveResources"],
        "properties": {
          "bugId": { "type": "string", "pattern": "^BUG-[0-9]{4}$" },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
          "category": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "items": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" }, "uniqueItems": true },
          "description": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "actualBehavior": { "type": "string", "minLength": 1 },
          "requiredBehavior": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "requiredCorrection": { "type": "string", "minLength": 1 },
          "acceptanceTest": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^BUG-[0-9]{4}$" }, "uniqueItems": true },
          "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "exclusiveResources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "checks": { "type": "array", "items": { "type": "string" } },
    "missingEvidence": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
