{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "pullRequest": {
      "type": "object",
      "required": [
        "id",
        "url",
        "state",
        "repository",
        "head",
        "headSha",
        "base",
        "baseSha",
        "mergeSha"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "minLength": 1
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "mergeSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "taskId",
        "title",
        "description",
        "status",
        "requirementIds",
        "planSections",
        "dependencies",
        "allowedPaths",
        "exclusiveResources",
        "acceptanceCriteria",
        "checks",
        "attemptCount",
        "branch",
        "worktree",
        "baseSha",
        "resultSha",
        "pullRequest",
        "lastError",
        "amendmentId",
        "supersededBy"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^TASK-[0-9]{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "active",
            "result_ready",
            "verified_ready",
            "submitted",
            "integrated",
            "superseded",
            "blocked"
          ]
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "planSections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
          },
          "uniqueItems": true
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exclusiveResources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "resultSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "pullRequest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/pullRequest"
            }
          ]
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "amendmentId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^AMEND-[0-9]{4}$"
        },
        "supersededBy": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "planHash",
    "definitionHash",
    "status",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "planHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(sha256:[0-9a-f]{64}|gitblob:[0-9a-f]{40,64})$"
    },
    "definitionHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "not_planned",
        "ready",
        "active",
        "complete",
        "blocked"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "additionalProperties": false
}
